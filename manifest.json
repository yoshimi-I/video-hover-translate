{
  "manifest_version": 3,
  "name": "Video Hover Translate",
  "version": "0.5.0",
  "description": "Disney+・Netflixの英語字幕をホバー翻訳。単語帳、復習クイズ、CSV・JSON・Ankiエクスポート。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.execute-api.ap-northeast-1.amazonaws.com/*",
    "https://www.disneyplus.com/*",
    "https://www.netflix.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.disneyplus.com/*",
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Video Hover Translate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
